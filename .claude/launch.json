    {
      "name": "cvs-dist-3x",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location -LiteralPath 'E:C-APP'; npx.cmd serve -l 5501 dist"
      ],
      "port": 5501
    }
  ]
}